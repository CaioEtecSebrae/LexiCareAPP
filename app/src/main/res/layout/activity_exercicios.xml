<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <br.gov.sp.etec.lexicare.views.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical">

        <!-- CABEÇALHO FIXO -->
        <FrameLayout
            android:id="@+id/headerTopo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="14dp"
            android:background="@color/background_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVoltar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_secondary"
                    android:text="←"
                    android:textSize="@dimen/ts_24"
                    android:padding="0dp"
                    android:insetTop="0dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_marginStart="10dp"
                    android:text="Exercícios de Leitura"
                    android:textSize="@dimen/ts_20"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>
        </FrameLayout>

        <!-- CONTEÚDO ROLÁVEL -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- SELETOR DE NÍVEL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNivelFacil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Nível 1"
                        android:textSize="@dimen/ts_14"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/button_secondary"/>

                    <Button
                        android:id="@+id/btnNivelMedio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="Nível 2"
                        android:textSize="@dimen/ts_14"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/button_secondary"/>

                    <Button
                        android:id="@+id/btnNivelDificil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Nível 3"
                        android:textSize="@dimen/ts_14"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/button_secondary"/>
                </LinearLayout>

                <!-- INFORMAÇÕES DE NÍVEL E PROGRESSO -->
                <TextView
                    android:id="@+id/tvNivelAtual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nível: Fácil"
                    android:textSize="@dimen/ts_14"
                    android:textColor="@color/text_hint"/>

                <TextView
                    android:id="@+id/tvProgresso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Progresso: 0 / 10 |  0 acertos"
                    android:textSize="@dimen/ts_14"
                    android:textStyle="bold"
                    android:textColor="@color/primary"/>

                <!-- CARD DA PALAVRA -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/exercicio_card_altura"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@color/background_card">

                        <TextView
                            android:id="@+id/tvPalavra"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/palavra_altura"
                            android:gravity="center"
                            android:text="A"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="@dimen/ts_72"
                            android:hyphenationFrequency="none"
                            android:breakStrategy="simple"
                            android:textStyle="bold"
                            android:textColor="@color/primary"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- FEEDBACK (logo abaixo da palavra, para sempre aparecer, mesmo em telas pequenas) -->
                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:textSize="@dimen/ts_18"
                    android:textStyle="bold"
                    android:textColor="@color/success"/>

                <!-- PERGUNTA -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Qual é a resposta correta?"
                    android:hyphenationFrequency="none"
                    android:breakStrategy="simple"
                    android:textSize="@dimen/ts_18"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <!-- OPÇÕES DE RESPOSTA -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnOpcao1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:layout_margin="5dp"
                        android:text="A"
                        android:textSize="@dimen/ts_17"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:hyphenationFrequency="none"
                        android:breakStrategy="simple"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/card_rounded"/>

                    <Button
                        android:id="@+id/btnOpcao2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:layout_margin="5dp"
                        android:text="B"
                        android:textSize="@dimen/ts_17"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:hyphenationFrequency="none"
                        android:breakStrategy="simple"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/card_rounded"/>

                    <Button
                        android:id="@+id/btnOpcao3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:layout_margin="5dp"
                        android:text="C"
                        android:textSize="@dimen/ts_17"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:hyphenationFrequency="none"
                        android:breakStrategy="simple"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/card_rounded"/>

                    <Button
                        android:id="@+id/btnOpcao4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:layout_margin="5dp"
                        android:text="D"
                        android:textSize="@dimen/ts_17"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:hyphenationFrequency="none"
                        android:breakStrategy="simple"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/card_rounded"/>
                </GridLayout>

            </LinearLayout>
        </ScrollView>
    </br.gov.sp.etec.lexicare.views.MaxWidthLinearLayout>
</FrameLayout>