<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- Conteúdo centralizado com largura máxima -->
        <br.gov.sp.etec.lexicare.views.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            app:larguraMaxima="@dimen/form_max_width">

            <!-- CABEÇALHO COM BOTÃO VOLTAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/tvFazerLogin"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_secondary"
                    android:insetTop="0dp"
                    android:padding="0dp"
                    android:text="←"
                    android:textSize="@dimen/ts_24" />

                <!-- Adicionar um campo de como deseja ser chamado que aparecerá em ("Olá, Usuário") -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Criar conta"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/ts_22"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CAMPO: NOME COMPLETO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nome completo"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ts_15"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNomeCompleto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/edittext_rounded"
                android:hint="Digite seu nome"
                android:minHeight="52dp"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:inputType="textPersonName|textMultiLine"
                android:gravity="top|start"
                android:imeOptions="actionNext"
                android:scrollHorizontally="false"
                android:hyphenationFrequency="none"
                android:breakStrategy="simple" />

            <!-- CAMPO: IDADE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Idade"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ts_15"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etIdade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/edittext_rounded"
                android:hint="Digite sua idade"
                android:inputType="number"
                android:maxLength="3"
                android:minHeight="52dp"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint" />

            <!-- CAMPO: SÉRIE / ANO ESCOLAR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Série / Ano escolar"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ts_15"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSerie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/edittext_rounded"
                android:hint="Ex.: 5º Ano"
                android:minHeight="52dp"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:inputType="text|textMultiLine"
                android:gravity="top|start"
                android:imeOptions="actionNext"
                android:scrollHorizontally="false"
                android:hyphenationFrequency="none"
                android:breakStrategy="simple" />

            <!-- CAMPO: E-MAIL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="E-mail"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ts_15"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmailCadastro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/edittext_rounded"
                android:hint="Digite seu e-mail"
                android:inputType="textEmailAddress|textMultiLine"
                android:gravity="top|start"
                android:imeOptions="actionNext"
                android:scrollHorizontally="false"
                android:hyphenationFrequency="none"
                android:breakStrategy="simple"
                android:minHeight="52dp"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint" />

            <!-- CAMPO: SENHA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Senha"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ts_15"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSenhaCadastro"
                android:maxLength="15"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/edittext_rounded"
                android:hint="Crie uma senha"
                android:inputType="textPassword"
                android:minHeight="52dp"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint" />

            <!-- SELEÇÃO: TIPO DE TRANSTORNO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tipo de transtorno"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ts_15"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTranstorno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbDislexia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/primary"
                    android:minHeight="48dp"
                    android:text="Dislexia"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbDisgrafia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/primary"
                    android:minHeight="48dp"
                    android:text="Disgrafia"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbAmbos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/primary"
                    android:minHeight="48dp"
                    android:text="Ambos"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- CAIXA DE AVISO (INFO) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_secondary"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️"
                    android:textSize="@dimen/ts_18" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Essas informações ajudam a personalizar os exercícios para você."
                    android:textColor="@color/primary"
                    android:textSize="@dimen/ts_14" />
            </LinearLayout>

            <!-- TERMOS DE CONSENTIMENTO (todos obrigatórios) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Termos de consentimento"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ts_15"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbTermosUso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/primary"
                android:minHeight="48dp"
                android:text="Li e aceito os Termos de Uso e a Política de Privacidade do LexiCare. *"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ts_14" />

            <CheckBox
                android:id="@+id/cbTratamentoDados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary"
                android:minHeight="48dp"
                android:text="Autorizo o tratamento dos meus dados pessoais e do tipo de transtorno informado, apenas para personalizar os exercícios (LGPD). *"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ts_14" />

            <CheckBox
                android:id="@+id/cbResponsavel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary"
                android:minHeight="48dp"
                android:text="Declaro que sou maior de idade ou que tenho a autorização de um responsável legal para usar o app. *"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/tvLerTermos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="44dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Ler os termos"
                android:textColor="@color/primary"
                android:textSize="@dimen/ts_14"
                android:textStyle="bold" />

            <!-- BOTÃO CADASTRAR -->
            <Button
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/button_rounded"
                android:minHeight="54dp"
                android:text="Cadastrar"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/ts_18"
                android:textStyle="bold" />

        </br.gov.sp.etec.lexicare.views.MaxWidthLinearLayout>
    </ScrollView>
</FrameLayout>