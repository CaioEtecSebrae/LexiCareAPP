<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <br.gov.sp.etec.lexicare.views.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">

            <!-- ÍCONE E TÍTULO DINÂMICOS CONFORME O RESULTADO -->
            <TextView
                android:id="@+id/tvEmojiResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐"
                android:textSize="@dimen/ts_48"/>

            <TextView
                android:id="@+id/tvTituloResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Resultado"
                android:textSize="@dimen/ts_26"
                android:textStyle="bold"
                android:textColor="@color/primary"/>

            <!-- MENSAGEM DINÂMICA -->
            <TextView
                android:id="@+id/tvMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="@dimen/ts_17"
                android:textColor="@color/text_secondary"/>

            <!-- CARDS DE ESTATÍSTICAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="30dp">

                <!-- CARD: ACERTOS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp"
                        android:background="@color/background_card">

                        <TextView
                            android:id="@+id/tvAcertos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/ts_32"
                            android:textStyle="bold"
                            android:textColor="@color/success"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Acertos"
                            android:textSize="@dimen/ts_14"
                            android:textColor="@color/text_hint"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CARD: TENTATIVAS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp"
                        android:background="@color/background_card">

                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="@dimen/ts_32"
                            android:textStyle="bold"
                            android:textColor="@color/warning"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tentativas"
                            android:textSize="@dimen/ts_14"
                            android:textColor="@color/text_hint"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
            <Button
                android:id="@+id/btnRefazerExercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_marginTop="30dp"
                android:text="Refazer exercício"
                android:textSize="@dimen/ts_17"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/button_rounded"/>

            <!-- BOTÃO VOLTAR AO INÍCIO -->
            <Button
                android:id="@+id/btnVoltarDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_marginTop="30dp"
                android:text="Voltar ao início"
                android:textSize="@dimen/ts_17"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/button_rounded"/>

        </br.gov.sp.etec.lexicare.views.MaxWidthLinearLayout>
    </ScrollView>
</FrameLayout>